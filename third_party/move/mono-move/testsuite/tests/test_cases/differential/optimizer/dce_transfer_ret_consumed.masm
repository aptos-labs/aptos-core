// RUN: publish --print(stackless)
module 0x66::dce_transfer_ret_consumed

fun one(): u64
    ld_u64 1
    ret

public fun overwrite_with_call(): u64
    local x: u64
    local y: u64
    ld_u64 5
    st_loc x
    call one
    move_loc x
    st_loc y
    st_loc x
    move_loc y
    ret

// RUN: execute 0x66::dce_transfer_ret_consumed::overwrite_with_call
// CHECK: results: 5
