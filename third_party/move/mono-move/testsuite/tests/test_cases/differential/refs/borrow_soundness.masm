// RUN: publish --print(stackless,micro-ops)
module 0x66::borrow_soundness

// borrow_loc source must not be substituted across copy.
fun borrow_loc_no_source_subst(x: u64): u64
    local y: u64
    copy_loc x
    st_loc y
    borrow_loc y
    read_ref
    ret

// Value uses can propagate through copy; only borrow_loc source is protected.
fun imm_borrow_value_prop(x: u64): u64
    local y: u64
    copy_loc x
    st_loc y
    borrow_loc y
    read_ref
    move_loc y
    add
    ret

// mut_borrow_loc must kill subst for the borrowed register.
fun mut_borrow_kills_subst(x: u64): u64
    local y: u64
    copy_loc x
    st_loc y
    ld_u64 42
    mut_borrow_loc y
    write_ref
    move_loc y
    ret

// Reverse direction: subst {tmp -> y} killed when y is mut-borrowed.
fun mut_borrow_kills_reverse(y: u64): u64
    local tmp: u64
    copy_loc y
    st_loc tmp
    ld_u64 99
    mut_borrow_loc y
    write_ref
    move_loc tmp
    ret

fun local_across_blocks(flag: bool, value: u64): u64
    local saved: u64
    copy_loc value
    st_loc saved
    move_loc flag
    br_true l1
    ld_u64 0
    ret
l1: move_loc saved
    ret

fun pre_borrow_copy(value: u64): u64
    copy_loc value
    ld_u64 99
    mut_borrow_loc value
    write_ref
    ret

// RUN: execute 0x66::borrow_soundness::borrow_loc_no_source_subst --args 7
// CHECK: results: 7

// RUN: execute 0x66::borrow_soundness::imm_borrow_value_prop --args 7
// CHECK: results: 14

// RUN: execute 0x66::borrow_soundness::mut_borrow_kills_subst --args 7
// CHECK: results: 42

// RUN: execute 0x66::borrow_soundness::mut_borrow_kills_reverse --args 7
// CHECK: results: 7

// RUN: execute 0x66::borrow_soundness::borrow_loc_no_source_subst --args 0
// CHECK: results: 0

// RUN: execute 0x66::borrow_soundness::borrow_loc_no_source_subst --args 18446744073709551615
// CHECK: results: 18446744073709551615

// RUN: execute 0x66::borrow_soundness::local_across_blocks --args true, 7
// CHECK: results: 7
// RUN: execute 0x66::borrow_soundness::local_across_blocks --args false, 7
// CHECK: results: 0

// RUN: execute 0x66::borrow_soundness::pre_borrow_copy --args 7
// CHECK: results: 7

// RUN: execute 0x66::borrow_soundness::pre_borrow_copy --args 12345
// CHECK: results: 12345
