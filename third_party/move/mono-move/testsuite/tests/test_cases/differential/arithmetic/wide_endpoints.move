// u256 division and remainder by divisors above 2^128, and i256 multiplication on each
// side of the signed range limits.

// RUN: publish
module 0x66::wide_endpoints {
    fun divmod(dividend: u256, divisor: u256): (u256, u256) { (dividend / divisor, dividend % divisor) }
    fun mul_i256(lhs: i256, rhs: i256): i256 { lhs * rhs }
}

// divisor = 2^128 + 1, dividend = (2^64 + 1) * divisor + 7.
// RUN: execute 0x66::wide_endpoints::divmod --args 6277101735386680764176071790128604879584176795969512275976, 340282366920938463463374607431768211457
// CHECK: results: 18446744073709551617, 7

// Divisor and dividend both above 2^128; quotient 2^126 + 3, remainder divisor - 1.
// RUN: execute 0x66::wide_endpoints::divmod --args 57896044618658097711785492504343953929782604226838962806765007122700420775955, 680564733841876926926749214863536422917
// CHECK: results: 85070591730234615865843651857942052867, 680564733841876926926749214863536422916

// (-2^200) * 2^55 = -2^255, the minimum.
// RUN: execute 0x66::wide_endpoints::mul_i256 --args -1606938044258990275541962092341162602522202993782792835301376, 36028797018963968
// CHECK: results: -57896044618658097711785492504343953926634992332820282019728792003956564819968

// (-2^200 - 1) * 2^55 is below the minimum.
// RUN: execute 0x66::wide_endpoints::mul_i256 --args -1606938044258990275541962092341162602522202993782792835301377, 36028797018963968
// CHECK-V1-SUBSTR: ARITHMETIC_ERROR
// CHECK-V2-SUBSTR: Mul: under/overflow
// CHECK-ERROR-PARITY

// 2^200 * 2^55 = 2^255 is one above the maximum.
// RUN: execute 0x66::wide_endpoints::mul_i256 --args 1606938044258990275541962092341162602522202993782792835301376, 36028797018963968
// CHECK-V1-SUBSTR: ARITHMETIC_ERROR
// CHECK-V2-SUBSTR: Mul: under/overflow
// CHECK-ERROR-PARITY

// (-2^200) * (-2^55) = 2^255 is one above the maximum.
// RUN: execute 0x66::wide_endpoints::mul_i256 --args -1606938044258990275541962092341162602522202993782792835301376, -36028797018963968
// CHECK-V1-SUBSTR: ARITHMETIC_ERROR
// CHECK-V2-SUBSTR: Mul: under/overflow
// CHECK-ERROR-PARITY

// (2^200 - 1) * 2^55 = 2^255 - 2^55, below the maximum.
// RUN: execute 0x66::wide_endpoints::mul_i256 --args 1606938044258990275541962092341162602522202993782792835301375, 36028797018963968
// CHECK: results: 57896044618658097711785492504343953926634992332820282019728755975159545856000
