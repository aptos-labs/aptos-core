module 0x77::control

public fun sum(n: u64): u64
    local i: u64
    local s: u64
    ld_u64 0
    st_loc i
    ld_u64 0
    st_loc s
l1: copy_loc i
    copy_loc n
    lt
    br_false l2
    copy_loc i
    ld_u64 1
    add
    st_loc i
    copy_loc s
    copy_loc i
    add
    st_loc s
    branch l1
l2: move_loc s
    ret

public fun fact(n: u64): u64
    copy_loc n
    ld_u64 0
    eq
    br_false l1
    ld_u64 1
    ret
l1: copy_loc n
    move_loc n
    ld_u64 1
    sub
    call fact
    mul
    ret

public fun abort_if_zero(x: u64): u64
    copy_loc x
    ld_u64 0
    neq
    br_true l1
    ld_u64 7
    abort
l1: move_loc x
    ret

public fun constants(): (u8, u64, i16, i256, u256)
    ld_const<u8> 255
    ld_const<u64> 18446744073709551615
    ld_const<i16> -32768
    ld_i256 -57896044618658097711785492504343953926634992332820282019728792003956564819968
    ld_u256 115792089237316195423570985008687907853269984665640564039457584007913129639935
    ret

fun private_seven(): u64
    ld_u64 7
    ret
