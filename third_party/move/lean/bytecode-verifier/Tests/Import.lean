import Import
import Tests.Builder

/-!
# Import tests

The fixtures under `Tests/fixtures/` are generated by the exporter; regenerate
them with the commands in `README.md`.

- `instructions.json` is the exporter's instruction catalog: every
  instruction once, with distinct operands. Decoding it must give exactly
  `expectedCatalog`, so the exporter and the decoder agree on every tag and
  operand. The exporter's own test checks that the catalog covers every
  instruction of `file_format::Bytecode`.
- `core.json` is assembled from `core_math.masm` and `core_client.masm` and is
  run by the reference semantics.
-/

namespace MoveBytecode.Tests

open MoveBytecode.Import

def expectedCatalog : Array Bytecode := #[
  .pop, .ret, .brTrue 1, .brFalse 2, .branch 3,
  .ldU8 (BitVec.ofNat 8 (2 ^ 8 - 1)), .ldU64 (BitVec.ofNat 64 (2 ^ 64 - 1)),
  .ldU128 (BitVec.ofNat 128 (2 ^ 128 - 1)),
  .castU8, .castU64, .castU128, .ldConst 4, .ldTrue, .ldFalse,
  .copyLoc 5, .moveLoc 6, .stLoc 7, .call 8, .callGeneric 9,
  .pack 10, .packGeneric 11, .packVariant 12, .packVariantGeneric 13,
  .unpack 14, .unpackGeneric 15, .unpackVariant 16, .unpackVariantGeneric 17,
  .testVariant 18, .testVariantGeneric 19,
  .readRef, .writeRef, .freezeRef, .mutBorrowLoc 20, .immBorrowLoc 21,
  .mutBorrowField 22, .mutBorrowVariantField 23, .mutBorrowFieldGeneric 24,
  .mutBorrowVariantFieldGeneric 25,
  .immBorrowField 26, .immBorrowVariantField 27, .immBorrowFieldGeneric 28,
  .immBorrowVariantFieldGeneric 29,
  .mutBorrowGlobal 30, .mutBorrowGlobalGeneric 31, .immBorrowGlobal 32,
  .immBorrowGlobalGeneric 33,
  .add, .sub, .mul, .mod, .div, .bitOr, .bitAnd, .xor, .or, .and, .not,
  .eq, .neq, .lt, .gt, .le, .ge, .abort, .nop,
  .exists_ 34, .existsGeneric 35, .moveFrom 36, .moveFromGeneric 37, .moveTo 38,
  .moveToGeneric 39,
  .shl, .shr,
  .vecPack 40 (2 ^ 64 - 1), .vecLen 41, .vecImmBorrow 42, .vecMutBorrow 43, .vecPushBack 44,
  .vecPopBack 45, .vecUnpack 46 47, .vecSwap 48,
  .packClosure 49 (BitVec.ofNat 64 (2 ^ 64 - 1)), .packClosureGeneric 50 (BitVec.ofNat 64 5),
  .callClosure 51,
  .ldU16 (BitVec.ofNat 16 (2 ^ 16 - 1)), .ldU32 (BitVec.ofNat 32 (2 ^ 32 - 1)),
  .ldU256 (BitVec.ofNat 256 (2 ^ 256 - 1)),
  .castU16, .castU32, .castU256,
  .ldI8 (BitVec.ofInt 8 (-(2 ^ 7))), .ldI16 (BitVec.ofInt 16 (-(2 ^ 15))),
  .ldI32 (BitVec.ofInt 32 (-(2 ^ 31))), .ldI64 (BitVec.ofInt 64 (-(2 ^ 63))),
  .ldI128 (BitVec.ofInt 128 (-(2 ^ 127))), .ldI256 (BitVec.ofInt 256 (-(2 ^ 255))),
  .castI8, .castI16, .castI32, .castI64, .castI128, .castI256,
  .negate, .abortMsg]

-- The catalog lists the constructors in declaration order.
#guard expectedCatalog.toList.map Bytecode.ctorIdx == List.range expectedCatalog.size

def readFixture (name : String) : IO String :=
  IO.FS.readFile (System.FilePath.mk "Tests/fixtures" / name)

def check (ok : Bool) (what : String) : IO Unit :=
  unless ok do throw (IO.userError s!"import test failed: {what}")

#eval show IO Unit from do
  let decoded ← IO.ofExcept (instructionCatalog (← readFixture "instructions.json"))
  check (decoded.size == expectedCatalog.size) "catalog size"
  for (d, e) in decoded.toList.zip expectedCatalog.toList do
    check (d == e) s!"catalog entry {repr e}"

#eval show IO Unit from do
  let P := (← IO.ofExcept (document (← readFixture "core.json"))).program
  check (P.modules.size == 2) "two modules"
  -- 0x66::client::run calls 0x66::math::sum(10).
  check (runFun P 1 0 [] == .returned [u64 55]) "client::run"
  check (runFun P 0 0 [u64 4] == .returned [u64 10]) "math::sum"
  check (runFun P 0 1 [.int .i8 (-7), .int .i8 2] == .returned [.int .i8 (-3)]) "math::div_i8"
  check (runFun P 0 1 [.int .i8 (-128), .int .i8 (-1)] == .failed .arithmetic) "div_i8 overflow"
  check (runFun P 0 2 [] == .returned [.int .i64 45]) "math::neg_i64"

end MoveBytecode.Tests
