module 0x66::math

public fun sum(n: u64): u64
    local i: u64
    local s: u64
    ld_u64 0
    st_loc i
    ld_u64 0
    st_loc s
l1: copy_loc i
    copy_loc n
    lt
    br_false l2
    copy_loc i
    ld_u64 1
    add
    st_loc i
    copy_loc s
    copy_loc i
    add
    st_loc s
    branch l1
l2: move_loc s
    ret

public fun div_i8(a: i8, b: i8): i8
    move_loc a
    move_loc b
    div
    ret

public fun neg_i64(): i64
    ld_i64 -45
    negate
    ret

fun secret(): u64
    ld_u64 7
    ret
