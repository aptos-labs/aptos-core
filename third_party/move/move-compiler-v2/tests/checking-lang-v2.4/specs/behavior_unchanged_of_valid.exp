// Bytecode version v10
module 0x42::M
struct R has drop + key
  v: u64

// Function definition at index 0
fun apply_unchanged(l0: |u64|, l1: u64)
    move_loc l1
    move_loc l0
    call_closure <|u64|>
    ret

// Function definition at index 1
fun apply_unchanged_binary(l0: |u64, u64|, l1: u64, l2: u64)
    move_loc l1
    move_loc l2
    move_loc l0
    call_closure <|u64, u64|>
    ret

// Function definition at index 2
fun caller(l0: address, l1: address) acquires R
    local l2: address
    local l3: address
    move_loc l0
    st_loc l2
    move_loc l1
    st_loc l3
    copy_loc l2
    // @5
    st_loc l0
    copy_loc l0
    borrow_global R
    borrow_field R, v
    read_ref
    // @10
    ld_u64 1
    add
    pack R
    move_loc l0
    mut_borrow_global R
    // @15
    write_ref
    nop
    ret


