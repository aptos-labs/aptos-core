//**** Cross-compiled for `move` syntax from `tests/control_flow/for_loop_bound_shadows_iter.move`

//# run
script {
    fun main() {
        let _v0 = 0;
        let _v1 = 0;
        let _v2 = 0;
        while (_v2 < 5) {
            _v0 = _v0 + 1;
            _v1 = _v1 + _v2;
            _v2 = _v2 + 1
        };
        assert!(_v0 == 5, 100);
        assert!(_v1 == 10, 101);
    }
}
