script {
    fun main() {
        let _v0 = 0;
        let _v1 = 0;
        while (_v1 < 5) {
            _v0 = _v0 + 1;
            while (_v0 < 5) _v0 = _v0 + 10;
            _v1 = _v1 + 1
        };
        assert!(_v0 == 15, 42);
        _v0 = 0;
        'l0: while (_v0 < 6) {
            _v1 = 0;
            loop {
                if (!(_v1 < 5)) continue 'l0;
                _v0 = _v0 + 1;
                _v1 = _v1 + 1
            };
            break
        };
        assert!(_v0 == 10, 43);
    }
}
