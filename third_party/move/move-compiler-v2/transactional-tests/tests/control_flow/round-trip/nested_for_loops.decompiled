//**** Cross-compiled for `move` syntax from `tests/control_flow/nested_for_loops.move`

//# run
script {
    fun main() {
        let _v0 = 0;
        let _v1 = 0;
        while (_v1 < 10) {
            _v0 = _v0 + 1;
            let _v2 = _v1;
            while (_v2 < 10) {
                _v0 = _v0 + 1;
                _v2 = _v2 + 1
            };
            _v1 = _v1 + 1;
            continue
        };
        assert!(_v0 == 65, 42);
    }
}
