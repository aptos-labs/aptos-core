module 0x42::invariant_wrong_header

fun f(x: u64): u64
    invariant fake: x < 100
    branch dispatch
fake: move_loc x
    ret
dispatch: copy_loc x
    ld_u64 100
    gt
    br_true fake
loop: copy_loc x
    ld_u64 0
    gt
    br_false exit
    copy_loc x
    ld_u64 1
    sub
    st_loc x
    branch loop
exit: move_loc x
    ret
