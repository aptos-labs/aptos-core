// A check on a signer behind a mutable reference says nothing once the reference is written: the
// `move_to` after the overwrite is not at a known system address, so `R` is havoced. The claim is
// true at runtime (only a holder of a system signer passes the check), so this pins a deliberate
// incompleteness.
module 0x1::system_addresses {
    use std::signer;
    public fun assert_aptos_framework(s: &signer) { assert!(signer::address_of(s) == @0x1, 3) }
}

module 0x1::sa_gated {
    use std::signer;
    use 0x1::system_addresses;
    struct R has key { v: u64 }
    public fun init(fw: &signer) { system_addresses::assert_aptos_framework(fw); move_to(fw, R { v: 0 }) }
    public fun set(fw: &signer, v: u64) acquires R {
        system_addresses::assert_aptos_framework(fw);
        R[signer::address_of(fw)].v = v;
    }
    public fun swap_init(s: &mut signer, t: signer) {
        system_addresses::assert_aptos_framework(s);
        *s = t;
        move_to(s, R { v: 0 })
    }
}

module 0x60::user {
    use 0x1::sa_gated;
    struct Cb has drop, copy { f: |u64| u64 has copy + drop }

    // Rejected: `swap_init`'s write is not known to be at a system address.
    public fun gated_invoke(c: &Cb, x: u64): u64 { (c.f)(x) }
    spec gated_invoke {
        requires exists<sa_gated::R>(@0x1);
        ensures global<sa_gated::R>(@0x1) == old(global<sa_gated::R>(@0x1));
    }
}

