//# publish
// The field must be declared with the same type in all listed variants, even if the
// instantiation makes the types coincide.
module 0x42::generic_non_uniform
enum E<T1, T2> has drop
  A
    x: T1
  B
    x: T2

fun get(e: &E<u8, u8>): u8
    move_loc e
    borrow_variant_field E<u8, u8>, A::x, B::x
    read_ref
    ret
