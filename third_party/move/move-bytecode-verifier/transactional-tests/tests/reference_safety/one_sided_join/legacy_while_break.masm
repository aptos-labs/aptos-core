//# publish
module 0x42::legacy_local
// Legacy Move compiler output for a `while` loop with `break`: the exit through the
// loop condition (`br_false l0`) does not pop the reference, the `break` exit does.
struct S has drop
  f: u64
  g: u64

public fun local_read_after(l0: u64): u64
    local l1: u64
    local l2: &mut S
    local l3: S
    ld_u64 0
    ld_u64 0
    pack S
    st_loc l3
    mut_borrow_loc l3
    // @5
    st_loc l2
    ld_u64 0
    st_loc l1
l3: copy_loc l1
    copy_loc l0
    // @10
    lt
    br_false l0
    branch l1
l1: copy_loc l1
    ld_u64 5
    // @15
    eq
    br_false l2
    move_loc l2
    pop
    branch l0
    // @20
l2: copy_loc l2
    borrow_field S, f
    read_ref
    ld_u64 1
    add
    // @25
    copy_loc l2
    mut_borrow_field S, f
    write_ref
    move_loc l1
    ld_u64 1
    // @30
    add
    st_loc l1
    branch l3
l0: borrow_loc l3
    borrow_field S, f
    // @35
    read_ref
    ret

//# publish
module 0x42::legacy_global
// Legacy Move compiler output for a `while` loop with `break`: the exit through the
// loop condition (`br_false l0`) does not pop the reference, the `break` exit does.
struct Store has key
  v: u64

public fun global_call_after(l0: address, l1: u64): u64 acquires Store
    local l2: u64
    local l3: &mut Store
    copy_loc l0
    mut_borrow_global Store
    st_loc l3
    ld_u64 0
    st_loc l2
    // @5
l3: copy_loc l2
    copy_loc l1
    lt
    br_false l0
    branch l1
    // @10
l1: copy_loc l3
    borrow_field Store, v
    read_ref
    ld_u64 100
    gt
    // @15
    br_false l2
    move_loc l3
    pop
    branch l0
l2: copy_loc l3
    // @20
    borrow_field Store, v
    read_ref
    ld_u64 1
    add
    copy_loc l3
    // @25
    mut_borrow_field Store, v
    write_ref
    move_loc l2
    ld_u64 1
    add
    // @30
    st_loc l2
    branch l3
l0: move_loc l0
    call read
    ret

fun read(l0: address): u64 acquires Store
    move_loc l0
    borrow_global Store
    borrow_field Store, v
    read_ref
    ret

public fun publish(l0: &signer)
    move_loc l0
    ld_u64 0
    pack Store
    move_to Store
    ret

//# run 0x42::legacy_local::local_read_after --args 3

//# run 0x42::legacy_local::local_read_after --args 10

//# run 0x42::legacy_global::publish --signers 0x42

//# run 0x42::legacy_global::global_call_after --args @0x42 3
