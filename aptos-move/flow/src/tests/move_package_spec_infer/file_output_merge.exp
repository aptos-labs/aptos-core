=== spec file (merged) ===
spec 0xCAFE::mergetest {
    spec fun helper(x: u64): u64 {
        x + 1
    }

    spec add_one(x: u64): u64 {
        ensures result == helper(x);
        pragma opaque = true;
        ensures [inferred] result == x + 1;
        aborts_if [inferred] x == MAX_U64;
    }
    spec double(x: u64): u64 {
        pragma opaque = true;
        ensures [inferred] result == x * 2;
        aborts_if [inferred] x * 2 > MAX_U64;
    }

    spec identity(value: 0xcafe::types::External): 0xcafe::types::External {
        use 0xcafe::types;
        pragma opaque = true;
        ensures [inferred] result == value;
        aborts_if [inferred] false;
    }

}
