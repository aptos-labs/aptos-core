  "AF-multisig-account-015": [
    {
      "mutant_id": "AF-multisig-account-015-ignore-owner",
      "file": "sources/AptosFramework/multisig_account.move",
      "anchor": "        is_owner(owner, multisig_account) &&\n            sequence_number == last_resolved_sequence_number(multisig_account) + 1 &&\n            num_approvals >= num_signatures_required(multisig_account)",
      "replace": "is_owner(owner, multisig_account)",
      "with": "true",
      "obligation_category": "normal-result",
      "rationale": "A non-owner must never be able to execute. Pins `result ==> owner in owners`."
    },
    {
      "mutant_id": "AF-multisig-account-015-out-of-range-returns-false",
      "file": "sources/AptosFramework/multisig_account.move",
      "anchor": "    public fun can_execute(owner: address, multisig_account: address, sequence_number: u64): bool {\n        assert_valid_sequence_number(multisig_account, sequence_number);",
      "replace": "assert_valid_sequence_number(multisig_account, sequence_number);",
      "with": "if (sequence_number == 0\n            || sequence_number >= MultisigAccount[multisig_account].next_sequence_number) {\n            return false\n        };",
      "obligation_category": "abort",
      "rationale": "An out-of-range sequence number must abort rather than answer `false`. Pins `aborts_if sequence_number == 0 || sequence_number >= next_sequence_number`. Deleting the assertion alone does not: `vote` aborts on the same range and the transaction table borrow aborts on the same key, so the abort is over-determined and no contract can see the deletion. Returning early removes every abort path."
    },
    {
      "mutant_id": "AF-multisig-account-015-sequence-inequality",
      "file": "sources/AptosFramework/multisig_account.move",
      "anchor": "        is_owner(owner, multisig_account) &&\n            sequence_number == last_resolved_sequence_number(multisig_account) + 1 &&\n            num_approvals >= num_signatures_required(multisig_account)",
      "replace": "sequence_number == last_resolved_sequence_number(multisig_account) + 1",
      "with": "sequence_number >= last_resolved_sequence_number(multisig_account) + 1",
      "obligation_category": "normal-result",
      "rationale": "Only the next transaction may execute. Pins `result ==> sequence_number == last_executed + 1`."
    }
  ],
