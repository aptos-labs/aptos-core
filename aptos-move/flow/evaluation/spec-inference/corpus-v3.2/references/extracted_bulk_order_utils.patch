+
+    spec module {
+        /// The strict adjacent ordering the scan checks. A pair is compared in
+        /// one direction only, so this is strict in both cases: equal
+        /// neighbours are rejected.
+        fun strictly_ordered(prices: vector<u64>, is_descending: bool): bool {
+            forall j: u64 where j + 1 < len(prices):
+                if (is_descending) { prices[j] > prices[j + 1] }
+                else { prices[j] < prices[j + 1] }
+        }
+
+        /// Where the search stops: the first level that no longer crosses.
+        fun stops_at(
+            prices: vector<u64>, best: u64, is_bid: bool, j: num
+        ): bool {
+            if (is_bid) { prices[j] < best } else { prices[j] > best }
+        }
+
+        /// Whether any level carries `price`.
+        fun has_price(prices: vector<u64>, price: u64): bool {
+            exists j in 0..len(prices): prices[j] == price
+        }
+
+        /// The least index carrying `price`. Only meaningful when one does.
+        fun first_index(prices: vector<u64>, price: u64): num {
+            choose min j in 0..len(prices) where prices[j] == price
+        }
+    }
+
+    spec validate_price_ordering {
+        pragma opaque;
+        // The `length() - 1` would underflow on an empty vector; the early
+        // return is what keeps this total.
+        aborts_if [inferred] false;
+        ensures [inferred] result == strictly_ordered(prices, is_descending);
+    }
+
+    spec discard_price_crossing_levels {
+        pragma opaque;
+        aborts_if [inferred] false;
+        ensures [inferred] std::option::spec_is_none(best_price) ==> result == 0;
+        // The least non-crossing index, stated as a prefix fact plus the
+        // stopping fact -- the result is not a fold of the vector.
+        ensures [inferred] std::option::spec_is_some(best_price) ==> (
+            result <= len(prices)
+                && (forall j: u64 where j < result:
+                        !stops_at(prices, std::option::spec_borrow(best_price), is_bid, j))
+                && (result < len(prices) ==>
+                        stops_at(prices, std::option::spec_borrow(best_price), is_bid, result))
+        );
+    }
+
+    spec cancel_at_price_level {
+        pragma opaque;
+        // Nothing in this body says `sizes` is as long as `prices`. Upstream
+        // both come from the bulk order and are built together; passed
+        // separately, the read at the found level can be out of range.
+        aborts_if [inferred] has_price(prices, price)
+            && first_index(prices, price) >= len(sizes);
+
+        // No match: both vectors keep their contents and the result is zero --
+        // which a genuine zero-size level also returns, so absence cannot be
+        // read out of the result alone.
+        ensures [inferred] !has_price(old(prices), price) ==> (
+            result == 0 && prices == old(prices) && sizes == old(sizes)
+        );
+
+        // A match at the least such index: both vectors lose exactly that
+        // index and nothing else moves.
+        ensures [inferred] has_price(old(prices), price) ==> (
+            result == old(sizes)[first_index(old(prices), price)]
+                && len(prices) == len(old(prices)) - 1
+                && len(sizes) == len(old(sizes)) - 1
+                && (forall j: num where 0 <= j && j < first_index(old(prices), price):
+                        prices[j] == old(prices)[j] && sizes[j] == old(sizes)[j])
+                && (forall j: num where first_index(old(prices), price) <= j && j < len(prices):
+                        prices[j] == old(prices)[j + 1])
+                && (forall j: num where first_index(old(prices), price) <= j && j < len(sizes):
+                        sizes[j] == old(sizes)[j + 1])
+        );
