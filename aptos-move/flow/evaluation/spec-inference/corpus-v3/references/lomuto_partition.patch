+        ensures [inferred] len(values) == len(old(values));
+        ensures [inferred] result < len(values);
+        ensures [inferred] values[result] == old(values)[pivot];
+        ensures [inferred] forall k in 0..result: values[k] < values[result];
+        ensures [inferred] forall k in result..len(values): values[k] >= values[result];
+        ensures [inferred] forall x: num: count(values, x, len(values)) == count(old(values), x, len(values));
+    } proof {
+        // Entry-point instantiation with the swapped vector as the trigger, so
+        // every `vector::swap` in the body -- which the prover encodes as
+        // exactly this double update -- meets the lemma.
+        forall v: vector<u64>, i: num, j: num, x: num
+            {count(update(update(v, i, v[j]), j, v[i]), x, len(v))}
+            apply count_swap(v, i, j, x);
