@@ -14,0 +15,6 @@ module aptos_framework::extracted_ethereum_derivable_account {
+    spec is_alpha {
+        pragma opaque;
+        aborts_if false;
+        ensures result == ((c >= 0x41 && c <= 0x5a) || (c >= 0x61 && c <= 0x7a));
+    }
+
@@ -26,0 +33,4 @@ module aptos_framework::extracted_ethereum_derivable_account {
+        } spec {
+            invariant len == std::vector::length(scheme);
+            invariant 1 <= i && i <= len;
