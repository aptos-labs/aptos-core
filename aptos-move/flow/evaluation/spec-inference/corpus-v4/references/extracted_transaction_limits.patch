+
+    spec new_tiers {
+        pragma opaque;
+        aborts_if tiers_rejected(min_stakes, multipliers_percent);
+        ensures built_from(result, min_stakes, multipliers_percent);
+    }
+
+    spec find_min_stake_required {
+        pragma opaque;
+        aborts_if !(exists j in 0..len(tiers): covers(tiers, multiplier_percent, j));
+        // The least covering tier, not the cheapest one.
+        ensures result == tiers[choose min j in 0..len(tiers) where covers(tiers, multiplier_percent, j)].min_stake;
+    }
+
+    spec validate_enough_stake {
+        pragma opaque;
+        let execution = multipliers.execution_multiplier_percent;
+        let io = multipliers.io_multiplier_percent;
