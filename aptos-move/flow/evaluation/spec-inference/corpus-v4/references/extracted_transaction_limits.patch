+    spec module {
+        /// Whether a multiplier lies in `(MIN_MULTIPLIER_PERCENT, MAX_MULTIPLIER_PERCENT]`.
+        fun valid_multiplier(multiplier_percent: u64): bool {
+            multiplier_percent > MIN_MULTIPLIER_PERCENT && multiplier_percent <= MAX_MULTIPLIER_PERCENT
+        }
+
+        /// Tier `k` against its predecessor: the stake may repeat, the
+        /// multiplier must grow.
+        fun ordered_at(tiers: vector<TxnLimitTier>, k: num): bool {
+            tiers[k].min_stake >= tiers[k - 1].min_stake
+                && tiers[k].multiplier_percent > tiers[k - 1].multiplier_percent
+        }
+
+        /// Every tier against its predecessor. Vacuous for fewer than two tiers.
+        fun ordered(tiers: vector<TxnLimitTier>): bool {
+            forall k: u64 where 1 <= k && k < len(tiers): ordered_at(tiers, k)
+        }
+
+        /// The first tier whose multiplier covers the request.
+        fun covers(tiers: vector<TxnLimitTier>, multiplier_percent: u64, j: num): bool {
+            tiers[j].multiplier_percent >= multiplier_percent
+        }
+
+        /// Whether some tier covers the request.
+        fun covered(tiers: vector<TxnLimitTier>, multiplier_percent: u64): bool {
+            exists j in 0..len(tiers): covers(tiers, multiplier_percent, j)
+        }
+
+        /// Whether `new_tiers` rejects these inputs: mismatched lengths, a
+        /// multiplier out of range, or inputs out of order.
+        fun tiers_rejected(min_stakes: vector<u64>, multipliers_percent: vector<u64>): bool {
+            len(min_stakes) != len(multipliers_percent)
+                || (exists j in 0..len(multipliers_percent): !valid_multiplier(multipliers_percent[j]))
+                || !(forall k: u64 where 1 <= k && k < len(min_stakes):
+                    min_stakes[k] >= min_stakes[k - 1] && multipliers_percent[k] > multipliers_percent[k - 1])
+        }
+
+        /// Whether `tiers` pairs the stakes with the multipliers, in order.
+        fun built_from(tiers: vector<TxnLimitTier>, min_stakes: vector<u64>, multipliers_percent: vector<u64>): bool {
+            len(tiers) == len(min_stakes)
+                && (forall j in 0..len(tiers):
+                    tiers[j] == TxnLimitTier { min_stake: min_stakes[j], multiplier_percent: multipliers_percent[j] })
+        }
+
+        /// The stake of the least covering tier.
+        fun min_stake_for(tiers: vector<TxnLimitTier>, multiplier_percent: u64): num {
+            tiers[choose min j in 0..len(tiers) where covers(tiers, multiplier_percent, j)].min_stake
+        }
+    }
