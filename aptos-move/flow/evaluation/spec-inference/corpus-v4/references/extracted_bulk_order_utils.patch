+    spec module {
+        /// The strict adjacent ordering the scan checks. A pair is compared in
+        /// one direction only, so this is strict in both cases: equal
+        /// neighbours are rejected.
+        fun strictly_ordered(prices: vector<u64>, is_descending: bool): bool {
+            forall j: u64 where j + 1 < len(prices):
+                if (is_descending) { prices[j] > prices[j + 1] }
+                else { prices[j] < prices[j + 1] }
+        }
+
+        /// Whether every size is nonzero.
+        fun all_nonzero(sizes: vector<u64>): bool {
+            forall j in 0..len(sizes): sizes[j] != 0
+        }
+
+        /// Where the search stops: the first level that no longer crosses.
+        fun stops_at(
+            prices: vector<u64>, best: u64, is_bid: bool, j: num
+        ): bool {
+            if (is_bid) { prices[j] < best } else { prices[j] > best }
+        }
+
+        /// Whether any level carries `price`.
+        fun has_price(prices: vector<u64>, price: u64): bool {
+            exists j in 0..len(prices): prices[j] == price
+        }
+
+        /// The least index carrying `price`. Only meaningful when one does.
+        fun first_index(prices: vector<u64>, price: u64): num {
+            choose min j in 0..len(prices) where prices[j] == price
+        }
+
+        /// Whether the reinserted price merges into the first level.
+        fun merges(prices: vector<u64>, other: OrderMatchDetails): bool {
+            len(prices) > 0 && prices[0] == other.price
+        }
+    }
+
+    spec new_bulk_order_request_with_sanitization {
+        pragma opaque;
+        aborts_if sequence_number == 0;
+        aborts_if len(bid_prices) != len(bid_sizes);
+        aborts_if len(ask_prices) != len(ask_sizes);
+        aborts_if len(bid_prices) == 0 && len(ask_prices) == 0;
+        aborts_if len(bid_prices) > MAX_BULK_ORDER_DEPTH_PER_SIDE;
+        aborts_if len(ask_prices) > MAX_BULK_ORDER_DEPTH_PER_SIDE;
+        aborts_if !all_nonzero(bid_sizes);
+        aborts_if !all_nonzero(ask_sizes);
+        aborts_if !strictly_ordered(bid_prices, true);
+        aborts_if !strictly_ordered(ask_prices, false);
+        // Only the best levels are compared: the two sides must not cross.
+        aborts_if len(bid_prices) > 0 && len(ask_prices) > 0 && bid_prices[0] >= ask_prices[0];
+        ensures result == bulk_order_types::new_bulk_order_request(
+            account, sequence_number, bid_prices, bid_sizes, ask_prices, ask_sizes, metadata
+        );
+    }
+
+    spec validate_not_zero_sizes {
+        pragma opaque;
+        aborts_if false;
+        ensures result == all_nonzero(sizes);
+    }
+
+    spec validate_price_ordering {
+        pragma opaque;
+        // The `length() - 1` would underflow on an empty vector; the early
+        // return is what keeps this total.
+        aborts_if false;
+        ensures result == strictly_ordered(prices, is_descending);
+    }
+
+    spec discard_price_crossing_levels {
+        pragma opaque;
+        aborts_if false;
+        ensures std::option::spec_is_none(best_price) ==> result == 0;
+        // The least non-crossing index, stated as a prefix fact plus the
+        // stopping fact -- the result is not a fold of the vector.
+        ensures std::option::spec_is_some(best_price) ==> (
