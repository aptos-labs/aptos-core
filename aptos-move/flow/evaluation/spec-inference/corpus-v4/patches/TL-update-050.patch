         while (i < len) {
             tiers.push_back(new_tier(min_stakes[i], multipliers_percent[i]));
             i += 1;
+        } spec {
+            invariant len == std::vector::length(min_stakes);
+            invariant len == std::vector::length(multipliers_percent);
